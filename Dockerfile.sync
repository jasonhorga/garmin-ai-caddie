# Application-only sync image. Dockerfile.sync-deps is built first as
# aicaddie-sync-deps:<content-hash>; source is copied from the exact API image
# so a sync tag can never contain code from the checkout used to build it.
ARG SYNC_DEPS_IMAGE
ARG API_IMAGE
FROM ${SYNC_DEPS_IMAGE} AS runtime
FROM ${API_IMAGE} AS api
FROM runtime

WORKDIR /app

COPY --from=api /app/ai_caddie/ ./ai_caddie/
COPY --from=api /app/contracts/canonical/ ./contracts/canonical/
COPY --from=api /app/mobile/contracts/ ./mobile/contracts/
COPY --from=api /app/server_v2/ ./server_v2/
COPY --from=api /app/ops/ ./ops/
COPY --from=api /app/alembic.ini ./
COPY --from=api /app/migrations/ ./migrations/

CMD ["sh", "ops/start_api.sh"]

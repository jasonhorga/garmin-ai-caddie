# frozen_string_literal: true
#
# AI Caddie iOS + Watch -> TestFlight
# (fastlane match for certs/profiles in this project's private git repo + App Store Connect API key;
# no Mac, no interactive Apple login). Signing is injected via xcargs so the existing
# simulator unit-test CI (xcodebuild test) is untouched.
#
# Required secrets (Team 6HB84897DJ):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_PRIVATE_KEY  (App Store Connect API key)
#   MATCH_GIT_URL, MATCH_GIT_PRIVATE_KEY, MATCH_PASSWORD  (fastlane match)
require "spaceship/connect_api"
require "securerandom"
require "shellwords"
require "json"
require "uri"
require "net/http"
require "ipaddr"

default_platform(:ios)

APP_NAME = "AI Caddie"
APP_BUNDLE_ID = "com.ai-caddie.mobile"
WATCH_BUNDLE_ID = "com.ai-caddie.mobile.watchkitapp"
XCODE_PROJECT = "mobile/ios/AICaddieNative.xcodeproj"  # generated by `xcodegen` in CI first
SCHEME = "AICaddie"
OUTPUT_IPA = "AICaddie.ipa"
KEYCHAIN = "aicaddie-ci-signing"
TEAM_ID = ENV.fetch("BETA_DEVELOPMENT_TEAM", "6HB84897DJ")

platform :ios do
  def load_asc_api_key!
    raw = ENV["ASC_PRIVATE_KEY"] || ""
    clean = raw.gsub("\\n", "\n").gsub("\r", "").delete(0.chr).strip
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: clean, is_key_content_base64: false, in_house: false
    )
  end

  def ensure_match_env!
    missing = %w[MATCH_GIT_URL MATCH_PASSWORD MATCH_GIT_PRIVATE_KEY].select { |k| ENV[k].to_s.strip.empty? }
    UI.user_error!("Missing signing env vars: #{missing.join(', ')}") unless missing.empty?
  end

  def ensure_upload_signing_env!
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_PRIVATE_KEY MATCH_GIT_URL MATCH_PASSWORD MATCH_GIT_PRIVATE_KEY]
    missing = required.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing signing env vars: #{missing.join(', ')}") unless missing.empty?
  end

  def match_keychain_password
    existing = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
    return existing unless existing.empty?

    ENV["MATCH_KEYCHAIN_PASSWORD"] = SecureRandom.hex(24)
  end

  def ensure_bundle_id!(identifier, name)
    bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
    return bundle if bundle

    UI.message("Creating Apple Developer Bundle ID #{identifier}.")
    Spaceship::ConnectAPI::BundleId.create(identifier: identifier, name: name, platform: "IOS")
  end

  def ensure_bundle_capabilities!(bundle, capabilities)
    enabled = bundle.get_capabilities
    capabilities.each do |capability_type|
      next if enabled.any? { |capability| capability.capability_type == capability_type }

      UI.message("Enabling Apple Developer capability #{capability_type} for #{bundle.identifier}.")
      bundle.create_capability(capability_type)
    end
  end

  def ensure_connect_app_record!(bundle)
    return if Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)

    UI.message("Creating App Store Connect app record for #{APP_BUNDLE_ID}.")
    Spaceship::ConnectAPI::App.create(
      name: APP_NAME,
      version_string: "1.0",
      sku: APP_BUNDLE_ID,
      primary_locale: "zh-Hans",
      bundle_id: bundle,
      platforms: ["IOS"]
    )
  end

  def make_keychain!
    create_keychain(name: KEYCHAIN, password: match_keychain_password,
                    default_keychain: true, unlock: true, timeout: 3600)
  end

  def build_xcargs
    args = [
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=\"Apple Distribution\""
    ]
    api_base_url = ENV["AI_CADDIE_API_BASE_URL"].to_s.strip
    args << "AI_CADDIE_API_BASE_URL=#{Shellwords.escape(api_base_url)}" unless api_base_url.empty?
    args.join(" ")
  end

  def release_commit!(required: false)
    value = ENV["GITHUB_SHA"].to_s.strip
    if value.empty?
      UI.user_error!("GITHUB_SHA is required for TestFlight upload") if required
      value = `git rev-parse HEAD`.to_s.strip
    end
    UI.user_error!("release commit must be a 40-character revision") unless value.match?(/\A[0-9a-fA-F]{40}\z/)

    value.downcase
  end

  def preflight_backend!
    origin = ENV["AI_CADDIE_API_BASE_URL"].to_s.strip
    UI.user_error!("AI_CADDIE_API_BASE_URL must be a public HTTPS origin for upload") if origin.empty?
    parsed = URI.parse(origin)
    host = parsed.host.to_s.downcase
    invalid_host = host.empty? || host == "localhost" || host.end_with?(".local")
    begin
      ip = IPAddr.new(host)
      invalid_host ||= ip.private? || ip.loopback? || ip.link_local? || ip.multicast? || ip.unspecified?
      invalid_host ||= ip.respond_to?(:reserved?) && ip.reserved?
      invalid_host ||= host.start_with?("240.") if ip.ipv4? && !invalid_host
    rescue IPAddr::InvalidAddressError
      # DNS host; public reachability is established by the HTTPS request.
    end
    UI.user_error!("AI_CADDIE_API_BASE_URL must be an origin-only public HTTPS URL") unless parsed.scheme == "https" && parsed.host && parsed.path.to_s.sub(%r{/\z}, "").empty? && parsed.query.nil? && parsed.fragment.nil? && parsed.user.nil? && parsed.password.nil? && !invalid_host
    token = ENV["AI_CADDIE_ADMIN_TOKEN"].to_s.strip
    UI.user_error!("AI_CADDIE_ADMIN_TOKEN is required for authenticated backend preflight") if token.empty?

    fetch_json = lambda do |path|
      uri = URI.parse(origin + path)
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      http.open_timeout = 20
      http.read_timeout = 20
      req = Net::HTTP::Get.new(uri)
      req["Accept"] = "application/json"
      req["X-AI-Caddie-Admin-Token"] = token
      response = http.request(req)
      UI.user_error!("backend preflight HTTP #{response.code}") unless response.code.to_i == 200
      JSON.parse(response.body)
    end

    health = fetch_json.call("/api/v2/health")
    UI.user_error!("backend health schema mismatch") unless health["schema"] == "ai-caddie-health-v2"
    readiness = fetch_json.call("/api/v2/readiness")
    checks = readiness["checks"]
    UI.user_error!("backend readiness evidence missing") unless readiness["schema"] == "ai-caddie-readiness-v1" && readiness["authenticated"] == true && readiness["runtimeStatus"] == "ready" && readiness["serviceStatus"] == "ready" && %w[ready degraded].include?(readiness["status"]) && checks.is_a?(Array) && !checks.empty? && checks.all? { |row| row.is_a?(Hash) && !row["label"].to_s.strip.empty? && %w[ready degraded error unknown].include?(row["state"]) }
    actual = health["revision"].to_s.strip.downcase
    UI.user_error!("backend health revision is missing or invalid") unless actual.match?(/\A[0-9a-fA-F]{40}\z/)
    expected = ENV["EXPECTED_BACKEND_REVISION"].to_s.strip.downcase
    unless expected.empty?
      UI.user_error!("EXPECTED_BACKEND_REVISION must be a 40-character revision") unless expected.match?(/\A[0-9a-f]{40}\z/)
      UI.user_error!("backend revision mismatch") unless actual == expected
    end
    health.merge("revision" => actual)
  rescue URI::InvalidURIError
    UI.user_error!("invalid AI_CADDIE_API_BASE_URL")
  end

  def validate_release_provenance!(path:, release_commit:, backend_revision:, api_origin:, upload_requested:)
    payload = JSON.parse(File.read(path))
    UI.user_error!("release provenance manifest is invalid") unless payload.is_a?(Hash)
    manifest_commit = payload["commit"].to_s.strip.downcase
    UI.user_error!("release provenance commit is missing") if manifest_commit.empty?
    UI.user_error!("release provenance commit is invalid") unless manifest_commit.match?(/\A[0-9a-f]{40}\z/i)
    UI.user_error!("release provenance commit does not match build commit") unless manifest_commit == release_commit

    requested = payload["uploadRequested"] == true
    completed = payload["uploadCompleted"] == true || payload["uploadToTestflight"] == true
    if upload_requested
      UI.user_error!("release provenance upload flag is missing") unless requested && completed && payload["uploadToTestflight"] == true
      manifest_backend = payload["backendRevision"].to_s.strip.downcase
      UI.user_error!("release provenance backend revision is missing") if manifest_backend.empty?
      UI.user_error!("release provenance backend revision is invalid") unless manifest_backend.match?(/\A[0-9a-f]{40}\z/i)
      UI.user_error!("release provenance backend revision does not match backend health") unless manifest_backend == backend_revision
      expected_host = URI.parse(api_origin).host.to_s.downcase
      UI.user_error!("release provenance API origin does not match build origin") unless expected_host != "" && payload["apiOriginHost"].to_s.strip.downcase == expected_host
    else
      UI.user_error!("release provenance upload state is inconsistent") if completed && !requested
    end
  rescue Errno::ENOENT, JSON::ParserError, URI::InvalidURIError
    UI.user_error!("release provenance manifest is unreadable")
  end

  desc "One-time: create the App Store Connect app record (idempotent) + app/watch signing assets"
  lane :bootstrap_signing do
    api_key = load_asc_api_key!
    ensure_match_env!
    make_keychain!
    app_bundle = ensure_bundle_id!(APP_BUNDLE_ID, APP_NAME)
    watch_bundle = ensure_bundle_id!(WATCH_BUNDLE_ID, "#{APP_NAME} Watch")

    begin
      ensure_connect_app_record!(app_bundle)
      UI.success("App Store Connect app record ensured.")
    rescue => e
      UI.important("App Store Connect app record was not created (#{e.message}); continuing with signing bootstrap.")
    end

    # Entitlements were added after the original match profiles were created. Keep the
    # Bundle IDs and profiles in sync before `match(force: true)` regenerates the assets.
    ensure_bundle_capabilities!(
      app_bundle,
      [Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH]
    )
    ensure_bundle_capabilities!(
      watch_bundle,
      [Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT]
    )

    match(
      api_key: api_key, type: "appstore", readonly: false, storage_mode: "git",
      git_url: ENV["MATCH_GIT_URL"], app_identifier: [APP_BUNDLE_ID, WATCH_BUNDLE_ID],
      keychain_name: KEYCHAIN, keychain_password: match_keychain_password,
      force: true, force_for_new_devices: false
    )
    UI.success("match bootstrap complete (app + watch).")
  end

  desc "Build the app (with embedded watch app) and upload to TestFlight"
  lane :beta do
    upload_requested = ENV.fetch("UPLOAD_TO_TESTFLIGHT", "false") == "true"
    release_commit = release_commit!(required: upload_requested)
    api_key = load_asc_api_key!
    ensure_match_env!
    ensure_upload_signing_env! if upload_requested
    make_keychain!
    match(
      api_key: api_key, type: "appstore", readonly: true, storage_mode: "git",
      git_url: ENV["MATCH_GIT_URL"], app_identifier: [APP_BUNDLE_ID, WATCH_BUNDLE_ID],
      keychain_name: KEYCHAIN, keychain_password: match_keychain_password
    )

    begin
      latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_BUNDLE_ID)
    rescue => e
      UI.important("No prior TestFlight build (#{e.message}); starting at 0")
      latest = 0
    end
    increment_build_number(build_number: latest + 1, xcodeproj: XCODE_PROJECT)

    app_profile = "match AppStore #{APP_BUNDLE_ID}"
    watch_profile = "match AppStore #{WATCH_BUNDLE_ID}"
    repo_root = File.expand_path("..", __dir__)
    ios_build_dir = File.join(repo_root, "build", "ios")
    provenance_script = File.join(repo_root, "ops", "write_release_provenance.py")
    build_app(
      project: XCODE_PROJECT, scheme: SCHEME, configuration: "Release",
      output_directory: ios_build_dir, output_name: OUTPUT_IPA,
      export_method: "app-store", clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_BUNDLE_ID => app_profile, WATCH_BUNDLE_ID => watch_profile }
      },
      xcargs: build_xcargs
    )

    backend = preflight_backend! if upload_requested
    backend_revision = upload_requested ? backend.fetch("revision") : ""
    api_origin = ENV["AI_CADDIE_API_BASE_URL"].to_s.strip
    provenance_args = [
      "python3 #{Shellwords.escape(provenance_script)}",
      "--ipa #{Shellwords.escape(File.join(ios_build_dir, OUTPUT_IPA))}",
      "--commit #{Shellwords.escape(release_commit)}",
      "--workflow-run #{Shellwords.escape(ENV.fetch('GITHUB_RUN_ID', 'local'))}",
      "--marketing-version #{Shellwords.escape(get_version_number(xcodeproj: XCODE_PROJECT, target: "AICaddie"))}",
      "--build-number #{Shellwords.escape(get_build_number(xcodeproj: XCODE_PROJECT))}"
    ].compact
    provenance_args << "--api-origin #{Shellwords.escape(api_origin)}" unless api_origin.empty?
    provenance_args << "--backend-revision #{Shellwords.escape(backend_revision)}" unless backend_revision.empty?
    provenance_args << "--upload-requested" if upload_requested
    sh(provenance_args.join(" "))

    validate_release_provenance!(
      path: File.join(ios_build_dir, "release-provenance.json"),
      release_commit: release_commit,
      backend_revision: backend_revision,
      api_origin: api_origin,
      upload_requested: false
    )

    if upload_requested
      upload_to_testflight(
        api_key: api_key, skip_waiting_for_build_processing: true,
        distribute_external: false, changelog: ENV.fetch("RELEASE_NOTES", "Automated CI build")
      )
      sh("#{provenance_args.join(' ')} --upload-to-testflight")
      validate_release_provenance!(
        path: File.join(ios_build_dir, "release-provenance.json"),
        release_commit: release_commit,
        backend_revision: backend_revision,
        api_origin: api_origin,
        upload_requested: true
      )
    else
      UI.success("Signed IPA built; TestFlight upload was not requested.")
    end
  end
end

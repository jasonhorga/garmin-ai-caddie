{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Caddie Live Round Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eventId",
    "roundId",
    "timestamp",
    "hole",
    "kind",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ai-caddie-live-round-event-v1"
    },
    "eventId": {
      "type": "string"
    },
    "roundId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "hole": {
      "type": "integer"
    },
    "kind": {
      "type": "string",
      "enum": [
        "score",
        "club",
        "putt",
        "penalty",
        "note",
        "location",
        "photo",
        "video",
        "sync_marker"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [],
      "properties": {}
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "score" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strokes"],
            "properties": {
              "strokes": { "type": "integer", "minimum": 1 },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "club" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clubName"],
            "properties": {
              "clubName": { "type": "string" },
              "source": { "type": "string" },
              "shotType": { "type": "string", "enum": ["tee", "approach", "recovery"] },
              "strategyMode": { "type": "string", "enum": ["protect_score", "stock", "attack"] },
              "lie": { "type": "string" },
              "distanceToPinM": { "type": ["number", "null"] },
              "offlineOptionId": { "type": ["string", "null"] },
              "decisionId": { "type": "string" },
              "decision": { "type": "object", "additionalProperties": true },
              "actualShot": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "putt" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["putts"],
            "properties": {
              "putts": { "type": "integer", "minimum": 0 },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "penalty" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["penalties"],
            "properties": {
              "penalties": { "type": "integer", "minimum": 0 },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "note" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["note"],
            "properties": {
              "note": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "location" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "source": { "type": "string" },
              "horizontalAccuracyM": { "type": ["number", "null"] },
              "altitudeM": { "type": ["number", "null"] },
              "targetLatitude": { "type": "number" },
              "targetLongitude": { "type": "number" },
              "targetSource": { "type": "string" },
              "targetKind": { "type": "string", "enum": ["pin", "target", "green_center"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "photo" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetLocalId", "mediaType"],
            "properties": {
              "assetLocalId": { "type": "string" },
              "mediaType": { "type": "string", "const": "photo" },
              "source": { "type": "string" },
              "fileURL": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] },
              "mediaId": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "video" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetLocalId", "mediaType"],
            "properties": {
              "assetLocalId": { "type": "string" },
              "mediaType": { "type": "string", "const": "video" },
              "source": { "type": "string" },
              "fileURL": { "type": ["string", "null"] },
              "durationS": { "type": ["number", "null"] },
              "note": { "type": ["string", "null"] },
              "mediaId": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sync_marker" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "type": "string" },
              "source": { "type": "string" },
              "acceptedEventIds": { "type": "array", "items": { "type": "string" } },
              "duplicateEventIds": { "type": "array", "items": { "type": "string" } },
              "serverSequence": { "type": "number" }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Caddie Live Round Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "roundId",
    "dataMode",
    "sourceCoverage",
    "missingData",
    "playerProfile",
    "course",
    "holes",
    "geometryCoverage",
    "caddieContextSeeds",
    "weatherSnapshot",
    "clubProfiles",
    "caddieDecisionEndpoint",
    "offlinePackageStatus",
    "eventCursor",
    "recentHistory",
    "cachedCaddieRules",
    "generatedAt"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ai-caddie-live-round-package-v1"
    },
    "roundId": {
      "type": "string"
    },
    "dataMode": {
      "type": "string",
      "enum": ["local", "fixture"]
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "dataMode",
        "requestedRoundId",
        "selectedRoundId",
        "roundFound",
        "availableRoundCount",
        "holeCount",
        "clubProfileCount"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "degraded"]
        },
        "dataMode": {
          "type": "string",
          "enum": ["local", "fixture"]
        },
        "requestedRoundId": {
          "type": "string"
        },
        "selectedRoundId": {
          "type": ["string", "null"]
        },
        "roundFound": {
          "type": "boolean"
        },
        "availableRoundCount": {
          "type": "integer"
        },
        "holeCount": {
          "type": "integer"
        },
        "clubProfileCount": {
          "type": "integer"
        },
        "preparationMode": {
          "type": "string",
          "enum": ["round", "course"]
        },
        "requestedCourseGlobalId": {
          "type": ["integer", "null"]
        },
        "courseFound": {
          "type": "boolean"
        }
      }
    },
    "missingData": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "playerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "displayName", "handedness"],
      "properties": {
        "playerId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handedness": {
          "type": "string",
          "enum": ["right", "left", "unknown"]
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globalId", "name", "teeBox"],
      "properties": {
        "globalId": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "teeBox": {
          "type": "string"
        }
      }
    },
    "holes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "par", "geometryCoverage"],
        "properties": {
          "number": {
            "type": "integer"
          },
          "par": {
            "type": "integer"
          },
          "yards": {
            "type": "integer"
          },
          "geometryCoverage": {
            "type": "string",
            "enum": ["ready", "partial", "missing"]
          }
        }
      }
    },
    "geometryCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "readyHoles", "totalHoles"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "partial", "missing"]
        },
        "readyHoles": {
          "type": "integer"
        },
        "totalHoles": {
          "type": "integer"
        }
      }
    },
    "caddieContextSeeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hole", "sourceRef", "shotTypes", "requiredLiveInputs", "context", "evidence", "missingData"],
        "properties": {
          "hole": {
            "type": "integer"
          },
          "sourceRef": {
            "type": "string"
          },
          "shotTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["tee", "approach", "recovery"]
            }
          },
          "requiredLiveInputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          },
          "selectedOfflineOptionId": {
            "type": ["string", "null"]
          },
          "offlineOptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "clubName", "carryM", "riskScore", "source", "sourceRefs"],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["safe", "stock", "attack"]
                },
                "label": {
                  "type": "string"
                },
                "clubName": {
                  "type": "string"
                },
                "carryM": {
                  "type": "number"
                },
                "riskScore": {
                  "type": "number"
                },
                "source": {
                  "type": "string"
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "missingData": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "weatherSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "state", "source", "confidence", "missingData"],
      "properties": {
        "schema": {
          "type": "string",
          "const": "ai-caddie-weather-snapshot-v1"
        },
        "state": {
          "type": "string",
          "enum": ["ready", "missing"]
        },
        "source": {
          "type": "string",
          "enum": ["manual", "open_meteo", "missing"]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "missingData": {
          "type": "array"
        }
      }
    },
    "clubProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clubName", "sampleSize", "median_m", "p10_m", "p90_m"],
        "properties": {
          "clubName": {
            "type": "string"
          },
          "sampleSize": {
            "type": "integer"
          },
          "median_m": {
            "type": "number"
          },
          "p10_m": {
            "type": "number"
          },
          "p90_m": {
            "type": "number"
          }
        }
      }
    },
    "caddieDecisionEndpoint": {
      "type": "string",
      "const": "/api/v2/caddie/decision"
    },
    "offlinePackageStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "preparedAt", "expiresAt", "cachePolicy"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "degraded", "expired"]
        },
        "preparedAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "cachePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["staleAfterHours", "expiresAfterHours"],
          "properties": {
            "staleAfterHours": {
              "type": "integer"
            },
            "expiresAfterHours": {
              "type": "integer"
            }
          }
        }
      }
    },
    "eventCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverSequence", "pendingEventCount"],
      "properties": {
        "serverSequence": {
          "type": "integer"
        },
        "pendingEventCount": {
          "type": "integer"
        }
      }
    },
    "recentHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course", "holes"],
      "properties": {
        "course": {
          "type": "object",
          "additionalProperties": true
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["roundId", "date", "courseName", "score", "par", "toPar", "holesCompleted", "sourceRefs"],
            "properties": {
              "roundId": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "courseName": {
                "type": "string"
              },
              "score": {
                "type": "integer"
              },
              "par": {
                "type": ["integer", "null"]
              },
              "toPar": {
                "type": ["integer", "null"]
              },
              "holesCompleted": {
                "type": "integer"
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "cachedCaddieRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionContract", "offlineCapable", "requiredInputs", "degradeWhenMissing"],
      "properties": {
        "decisionContract": {
          "type": "string",
          "const": "ai-caddie-decision-v2"
        },
        "offlineCapable": {
          "type": "boolean"
        },
        "requiredInputs": {
          "type": "array"
        },
        "degradeWhenMissing": {
          "type": "array"
        }
      }
    },
    "generatedAt": {
      "type": "string"
    }
  }
}

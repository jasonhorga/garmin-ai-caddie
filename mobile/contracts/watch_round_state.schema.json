{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Caddie Watch Round State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "roundId",
    "hole",
    "par",
    "availableClubs",
    "score",
    "putts",
    "penaltyCount",
    "caddieConfidence"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ai-caddie-watch-round-state-v1"
    },
    "roundId": {
      "type": "string",
      "minLength": 1
    },
    "hole": {
      "type": "integer",
      "minimum": 1
    },
    "par": {
      "type": "integer",
      "minimum": 3,
      "maximum": 6
    },
    "distanceM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "teeLatitude": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90
    },
    "teeLongitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180
    },
    "targetNote": {
      "type": ["string", "null"]
    },
    "targetLatitude": {
      "type": ["number", "null"]
    },
    "targetLongitude": {
      "type": ["number", "null"]
    },
    "targetKind": {
      "type": ["string", "null"],
      "enum": ["pin", "target", "green_center", null]
    },
    "suggestedClub": {
      "type": ["string", "null"]
    },
    "selectedClub": {
      "type": ["string", "null"]
    },
    "availableClubs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clubName"],
        "properties": {
          "clubName": {
            "type": "string",
            "minLength": 1
          },
          "sampleSize": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "medianM": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "source": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "shotType": {
      "type": ["string", "null"],
      "enum": ["tee", "approach", "recovery", null]
    },
    "strategyMode": {
      "type": ["string", "null"],
      "enum": ["protect_score", "stock", "attack", null]
    },
    "lie": {
      "type": ["string", "null"]
    },
    "offlineOptionId": {
      "type": ["string", "null"]
    },
    "decisionId": {
      "type": ["string", "null"]
    },
    "nextShotPrompt": {
      "type": ["string", "null"]
    },
    "holePlanSummary": {
      "type": ["string", "null"]
    },
    "expectedRemainingM": {
      "type": ["number", "null"]
    },
    "evidenceSummary": {
      "type": ["string", "null"]
    },
    "missingDataSummary": {
      "type": ["string", "null"]
    },
    "frontGreenM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "centerGreenM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "backGreenM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "frontGreenLat": { "type": ["number", "null"] },
    "frontGreenLon": { "type": ["number", "null"] },
    "centerGreenLat": { "type": ["number", "null"] },
    "centerGreenLon": { "type": ["number", "null"] },
    "backGreenLat": { "type": ["number", "null"] },
    "backGreenLon": { "type": ["number", "null"] },
    "holeImageProjection": {
      "type": ["object", "null"],
      "properties": {
        "widthPx": { "type": ["integer", "null"] },
        "heightPx": { "type": ["integer", "null"] },
        "refs": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" }, "lon": { "type": "number" },
              "px": { "type": "number" }, "py": { "type": "number" }
            }
          }
        }
      }
    },
    "globalId": {
      "type": ["integer", "null"]
    },
    "holeMap": {
      "type": ["object", "null"],
      "description": "watch P1b: five hole-map overlay anchors in /topo.png px space (phone-computed from the centreline route).",
      "properties": {
        "w": { "type": "integer" },
        "h": { "type": "integer" },
        "you": { "type": "array", "items": { "type": "number" } },
        "pin": { "type": "array", "items": { "type": "number" } },
        "layup": { "type": "array", "items": { "type": "number" } },
        "apex": { "type": "array", "items": { "type": "number" } },
        "greenCtrl": { "type": "array", "items": { "type": "number" } }
      }
    },
    "playsLikeDistanceM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "elevationDeltaM": {
      "type": ["number", "null"]
    },
    "lastShotDistanceM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "distanceFromLastShotM": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "greenInRegulation": {
      "type": ["boolean", "null"]
    },
    "fairwayResult": {
      "type": ["string", "null"]
    },
    "geometryCoverage": {
      "type": ["string", "null"],
      "enum": ["ready", "partial", "missing", null]
    },
    "geometryRevision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{16}$"
    },
    "caddieOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "label"],
        "properties": {
          "optionId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "clubName": {
            "type": ["string", "null"]
          },
          "carryM": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "carryP10M": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "carryP90M": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "sampleSize": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "plan": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clubName"],
              "properties": {
                "clubName": {
                  "type": "string",
                  "minLength": 1
                },
                "carryM": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              }
            }
          },
          "confidence": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["bunker", "water"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "startM": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "endM": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 1
    },
    "putts": {
      "type": "integer",
      "minimum": 0
    },
    "penaltyCount": {
      "type": "integer",
      "minimum": 0
    },
    "caddieConfidence": {
      "type": "string",
      "minLength": 1
    }
  }
}

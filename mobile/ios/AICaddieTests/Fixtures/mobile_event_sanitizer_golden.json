    {
      "name": "photo_local_path_nested_secrets_and_exact_identity",
      "input": {
        "schema": "ai-caddie-live-round-event-v1",
        "eventId": "token=identity-secret",
        "roundId": "round-privacy-1",
        "clientId": "ios-phone",
        "timestamp": "2026-07-21T00:00:00Z",
        "hole": 1,
        "kind": "photo",
        "payload": {
          "fileURL": "file:///private/mobile/photo.jpg",
          "note": "token=alpha from /home/ubuntu/secret.txt",
          "nested": {
            "password": "password hunter2",
            "refs": [
              "/tmp/a.txt",
              "safe"
            ]
          }
        }
      },
      "expected": {
        "schema": "ai-caddie-live-round-event-v1",
        "eventId": "token=identity-secret",
        "roundId": "round-privacy-1",
        "clientId": "ios-phone",
        "timestamp": "2026-07-21T00:00:00Z",
        "hole": 1,
        "kind": "photo",
        "payload": {
          "fileURL": "[REDACTED_LOCAL_MEDIA_URL]",
          "note": "token=[REDACTED] from [REDACTED_PATH]",
          "nested": {
            "password": "password [REDACTED]",
            "refs": [
              "[REDACTED_PATH]",
              "safe"
            ]
          }
        }
      }
    },

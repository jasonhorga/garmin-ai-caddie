# Copy to .env for local private runs. Keep real secrets out of git.

# Runtime mode
AI_CADDIE_SECURITY_PROFILE=private
AI_CADDIE_ADMIN_TOKEN=replace-with-random-admin-token
AI_CADDIE_DATA_MODE=local_or_fixture
AI_CADDIE_API_PUBLISH_HOST=127.0.0.1
AI_CADDIE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Useful for Vercel preview URLs:
# AI_CADDIE_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend build/runtime
VITE_AI_CADDIE_API_BASE_URL=http://127.0.0.1:9000

# AI providers. Leave static for fixture/offline development.
AI_CADDIE_LLM_PROVIDER=static
# NVIDIA_API_KEY=
# NVIDIA_NIM_BASE_URL=
# NVIDIA_NIM_MODEL=
# GEMINI_API_KEY=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_OAUTH_CREDENTIALS_FILE=
# GEMINI_OAUTH_CREDENTIALS_B64=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# ANTHROPIC_API_KEY=

# Garmin OAuth feasibility probe only; CN Web Session remains primary.
# AI_CADDIE_GARMIN_OAUTH_CLIENT_ID=
# AI_CADDIE_GARMIN_OAUTH_CLIENT_SECRET=
# AI_CADDIE_GARMIN_OAUTH_REDIRECT_URI=
# AI_CADDIE_GARMIN_OAUTH_SCOPES=
